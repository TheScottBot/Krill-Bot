# Discord application token. Keep the real value only in .env or .env.dev.
DISCORD_TOKEN=

# Optional comma-separated server IDs for immediate development command sync.
GUILD_IDS=

# Local clock used when servers configure daily posts.
BOT_TIMEZONE=Europe/London

# Daily post and Krillion reset times for servers that choose none, in BOT_TIMEZONE.
DAILY_POST_TIME=17:00
DAILY_RESET_TIME=04:00

# Paths are relative to the repository root unless made absolute.
DATABASE_PATH=krillbot.db
LOG_PATH=logs/krillbot.log

